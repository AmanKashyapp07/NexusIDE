{
  "language": "Node.js",
  "image": "node:20-alpine",
  "stages": {
    "setup": {
      "run": "npm --prefix backend install && npm --prefix frontend install"
    },
    "services": {
      "needs": ["setup"],
      "run": "cd backend && npx vitest run ../testing/services/ --reporter=default"
    },
    "security": {
      "needs": ["setup"],
      "run": "cd backend && npx vitest run ../testing/services/container-security.test.ts ../testing/services/rbac-security.test.ts --reporter=default"
    },
    "resilience": {
      "needs": ["setup"],
      "run": "cd backend && npx vitest run ../testing/services/network-resilience.test.ts ../testing/services/redis-cluster-failures.test.ts --reporter=default"
    },
    "timelapse": {
      "needs": ["setup"],
      "run": "cd backend && npx vitest run ../testing/services/timelapseEngine.test.ts ../testing/services/timelapse.test.ts --reporter=default"
    },
    "integration": {
      "needs": ["setup"],
      "run": "cd backend && npx vitest run ../testing/integration/ --reporter=default"
    },
    "db": {
      "needs": ["setup"],
      "run": "bash test-db.sh"
    },
    "frontend": {
      "needs": ["setup"],
      "run": "cd frontend && npx vitest run ../testing/frontend/ --reporter=default"
    },
    "build": {
      "needs": ["services", "security", "resilience", "timelapse", "integration", "db", "frontend"],
      "run": "cd frontend && npm run build"
    }
  }
}
