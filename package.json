{
  "name": "sandbox-root",
  "private": true,
  "scripts": {
    "deploy":        "bash deploy.sh",
    "deploy:quick":  "bash deploy.sh --quick",
    "deploy:backend":"bash deploy.sh --backend",
    "deploy:frontend":"bash deploy.sh --frontend",
    "deploy:full":   "bash deploy.sh --full",
    "test:backend":  "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e":      "npm --prefix frontend run test:e2e",
    "test:db":       "bash test-db.sh",
    "test:db:tunnel":"bash test-db.sh --tunnel",
    "test:all":      "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "typecheck":     "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend":  "npm --prefix backend exec tsc -- --noEmit",
    "typecheck:frontend": "npm --prefix frontend exec tsc -- --noEmit -p tsconfig.app.json"
  }
}
