{
  "name": "nexus-ide",
  "private": true,
  "scripts": {
    "deploy": "bash scripts/deploy.sh",
    "deploy:quick": "bash scripts/deploy.sh --quick",
    "deploy:backend": "bash scripts/deploy.sh --backend",
    "deploy:frontend": "bash scripts/deploy.sh --frontend",
    "deploy:full": "bash scripts/deploy.sh --full",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:db": "bash scripts/test-db.sh",
    "test:db:tunnel": "bash scripts/test-db.sh --tunnel",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "backend/node_modules/.bin/tsc -p backend/tsconfig.json --noEmit",
    "typecheck:frontend": "frontend/node_modules/.bin/tsc -p frontend/tsconfig.app.json --noEmit"
  }
}
