# =============================================================================
# NexusIDE — Local Development Environment Variables
# =============================================================================
# Copy this file to backend/.env and fill in your values.
# cp .env.local.example backend/.env
#
# Required services: PostgreSQL 16, Redis 7, Docker Engine
# =============================================================================

# --- PostgreSQL ---
# Format: postgresql://<user>@<host>:<port>/<dbname>
# Default local setup (no password): postgresql://postgres@localhost:5432/sandbox
# With password: postgresql://postgres:yourpassword@localhost:5432/sandbox
DATABASE_URL="postgresql://postgres@localhost:5432/sandbox"

# --- Auth ---
# Any random string for local dev; use a strong secret in production
JWT_SECRET="local_dev_secret_change_me"

# --- Redis ---
# Leave blank to use defaults (localhost:6379, no password)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=          # uncomment if your local Redis has a password
# REDIS_URL=               # optional: full redis:// URL overrides host/port/password

# --- Server ---
PORT=4000
FRONTEND_URL="http://localhost:5173/ide"
LOG_LEVEL=debug

# --- GitHub OAuth (optional for local dev) ---
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:4000/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- AI Keys (optional — only needed if using AI features) ---
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=

